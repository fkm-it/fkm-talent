    { "key": "jawatan", "label": "Jawatan", "type": "string", "max": 60, "list": true, "search": true, "placeholder": "cth. Profesor Madya DS54" },
    { "key": "gred", "label": "Gred", "type": "string", "max": 20, "search": true },
    { "key": "jawatanPentadbiran", "label": "Jawatan pentadbiran", "type": "string", "max": 30, "placeholder": "LECTURER / HOD / DEAN / TDA …" },
