{
  "key": "staf",
  "name": "Staf",
  "label": "Staf Akademik",
  "labelPlural": "Staf Akademik",
  "icon": "users",
  "prefix": "SF",
  "refFormat": "STF-{SEQ4}",
  "description": "Profil, pencapaian KPI dan status perkhidmatan staf akademik FKM. Diisi melalui import, Auto-Extract CV atau suntingan admin.",
  "access": { "create": "ADMIN", "list": "OWN", "edit": "ADMIN", "delete": "ADMIN" },
  "notify": { "adminsOnCreate": false, "ownerOnStatus": false },
  "statuses": [
    { "value": "AKTIF", "label": "Aktif", "tone": "success" },
    { "value": "TIDAK_AKTIF", "label": "Tidak aktif", "tone": "muted" },
    { "value": "BERSARA", "label": "Bersara", "tone": "muted" },
    { "value": "LETAK_JAWATAN", "label": "Letak jawatan / berpindah", "tone": "warn" },
    { "value": "TAMAT_KONTRAK", "label": "Tamat kontrak", "tone": "danger" }
  ],
  "titleField": "nama",
  "subtitleField": "jawatan",
  "nav": { "user": false, "admin": true, "order": 10 },
  "fields": [
    { "key": "staffId", "label": "Staff ID", "type": "string", "required": true, "max": 12, "list": true, "search": true, "lockAfterCreate": true, "hint": "Kunci utama — padanan untuk Auto-Extract CV." },
    { "key": "gelaran", "label": "Gelaran", "type": "string", "max": 40, "placeholder": "cth. PROF. IR. DR." },
    { "key": "nama", "label": "Nama penuh", "type": "string", "required": true, "max": 120, "list": true, "search": true },
    { "key": "email", "label": "E-mel UTM", "type": "email", "search": true },
    { "key": "telefon", "label": "Telefon", "type": "phone", "adminOnly": true },
    { "key": "jabatan", "label": "Jabatan", "type": "enum", "required": true, "list": true, "filter": true,
      "options": [
        { "value": "KAAS", "label": "KAAS — Aeronautik, Automotif & Ocean" },
        { "value": "KBPI", "label": "KBPI — Bahan, Pembuatan & Industri" },
        { "value": "MGR", "label": "MGR — Mekanikal Gunaan & Reka Bentuk" },
        { "value": "TB", "label": "TB — Termo-Bendalir" },
        { "value": "AAS", "label": "AAS — Aeroangkasa" }
