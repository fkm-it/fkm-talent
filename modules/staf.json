      "options": ["DS14", "DS54", "VK7", "VK6", "VK5", "VK5 (Kekal)"] },
    { "key": "kelayakan", "label": "Kelayakan tertinggi", "type": "string", "max": 40 },
    { "key": "bidangKepakaran", "label": "Bidang kepakaran", "type": "string", "max": 120, "search": true },
    { "key": "nicheArea", "label": "Niche area FKM", "type": "string", "max": 120 },
